# NovaPilot — safe defaults. Copy to .env and edit. No keys required for the default local setup.
# NEVER commit a real .env.

# --- Core ---
NOVAPILOT_ENV=dev
DATABASE_URL=<redacted>
# DATABASE_URL=<redacted>

# Optional bearer token. Unset = API is open (dev warning logged at boot).
# NOVAPILOT_TOKEN=<redacted>
WORKSPACE_DIR=./workspace
MEMORY_NAMESPACE=default
# MEMORY_BACKEND=sqlite   # or: mem0 (optional, needs mem0 installed + config)

# --- Model gateway (LiteLLM). Default: local Ollama, $0 ---
MODEL_DEFAULT=ollama/gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434
FALLBACK_MODELS=groq/gpt-oss-120b,gemini/gemini-2.5-flash,openrouter/qwen/qwen3-32b:free

# Optional free-tier cloud fallbacks (keys only if you want them; BYOK)
# GROQ_API_KEY=<redacted>
# GEMINI_API_KEY=<redacted>
# OPENROUTER_API_KEY=<redacted>

# --- Budgets (per task; enforced, not suggested) ---
TASK_MAX_COST_USD=0.50
TASK_MAX_TOKENS=200000
TASK_MAX_WALLCLOCK_SEC=1800

# --- Security ---
SECRET_KEY=change-me-to-a-random-32-byte-string

# --- Browser workspace (M5) ---
# Comma-separated allowed domains. Empty = unrestricted (dev only).
# BROWSER_ALLOWED_DOMAINS=example.com,app.example.com

# --- Shell sandbox (Phase D) ---
# Set to "docker" to give the agent a full shell inside a locked-down
# container (no network, capped resources). Requires Docker at runtime.
# NOVAPILOT_SANDBOX=docker

# --- Channels (Phase C) ---
# TELEGRAM_BOT_TOKEN=<redacted>
# TELEGRAM_ALLOWED_USERS=123456789,987654321   # empty = anyone (not recommended)

# --- MCP servers (Phase C) ---
# JSON list of {name, command, args, env}. Tools appear as mcp_<name>_<tool>.
# MCP_SERVERS=[{"name":"weather","command":"python3","args":["/path/to/weather_server.py"]}]
