# NovaPilot — safe defaults. Copy to .env and edit. No keys required for the default local setup.
# NEVER commit a real .env.

# --- Core ---
NOVAPILOT_ENV=dev
DATABASE_URL=sqlite+aiosqlite:///./novapilot.db
# DATABASE_URL=postgresql+asyncpg://novapilot:novapilot@localhost:5432/novapilot  # multi-user option

# --- Model gateway (LiteLLM). Default: local Ollama, $0 ---
MODEL_DEFAULT=ollama/gpt-oss:20b
OLLAMA_BASE_URL=http://localhost:11434

# Optional free-tier cloud fallbacks (keys only if you want them; BYOK)
# GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# --- Budgets (per task; enforced, not suggested) ---
TASK_MAX_COST_USD=0.50
TASK_MAX_TOKENS=200000
TASK_MAX_WALLCLOCK_SEC=1800

# --- Security ---
SECRET_KEY=change-me-to-a-random-32-byte-string
