# Actlet — safe defaults. Copy to .env and edit. No keys required for the default local setup.
# NEVER commit a real .env.

# --- Core ---
ACTLET_ENV=dev
DATABASE_URL=<redacted>
# DATABASE_URL=<redacted>

# Optional bearer token. Unset = API is open (dev warning logged at boot).
# ACTLET_TOKEN=<redacted>
WORKSPACE_DIR=./workspace
MEMORY_NAMESPACE=default
# MEMORY_BACKEND=embedded   # or: mem0 (optional, needs mem0 installed + config)

# --- Model gateway (LiteLLM). Smart default: best free model with a key, local fallback ---
# Chain: NVIDIA 70B (free key) → Groq 70B (free key) → Gemini Flash (free key) → Ollama local ($0, offline)
MODEL_DEFAULT=nvidia_nim/meta/llama-3.3-70b-instruct
OLLAMA_BASE_URL=http://localhost:11434
MODEL_FALLBACKS=groq/llama-3.3-70b-versatile,gemini/gemini-2.5-flash,ollama/gpt-oss:20b
# No keys at all? Ollama local still works — private, offline, $0.

# Optional free-tier cloud fallbacks (keys only if you want them; BYOK)
# GROQ_API_KEY=<redacted>
# GEMINI_API_KEY=<redacted>
# OPENROUTER_API_KEY=<redacted>
# NVIDIA_API_KEY=<redacted>  (free credits at build.nvidia.com; add nvidia_nim/... to MODEL_FALLBACKS)
# CEREBRAS_API_KEY=<redacted>  (free tier at cerebras.ai)
# MISTRAL_API_KEY=<redacted>  (free Experiment tier at console.mistral.ai)
# COHERE_API_KEY=<redacted>  (free trial key at dashboard.cohere.com)
# HF_TOKEN=<redacted>  (HuggingFace Inference, free tier)
# TOGETHER_API_KEY=<redacted>  (free credits at together.ai)
# FIREWORKS_API_KEY=<redacted>  (free credits at fireworks.ai)
# CLOUDFLARE_API_KEY=<redacted> + CLOUDFLARE_ACCOUNT_ID=<redacted>  (10k neurons/day free)

# --- Budgets (per task; enforced, not suggested) ---
TASK_MAX_COST_USD=0.50
TASK_MAX_TOKENS=200000
TASK_MAX_WALLCLOCK_SEC=1800

# --- Security ---
SECRET_KEY=change-me-to-a-random-32-byte-string

# --- Browser workspace (M5) ---
# Comma-separated allowed domains. Empty = unrestricted (dev only).
# BROWSER_ALLOWED_DOMAINS=example.com,app.example.com

# --- Shell sandbox (Phase D) ---
# Set to "docker" to give the agent a full shell inside a locked-down
# container (no network, capped resources). Requires Docker at runtime.
# ACTLET_SANDBOX=docker

# --- Channels (Phase C) ---
# TELEGRAM_BOT_TOKEN=<redacted>
# TELEGRAM_ALLOWED_USERS=123456789,987654321   # empty = anyone (not recommended)

# --- Gmail (Phase F) ---
# Google App Password required (Google Account → Security → 2-Step Verification → App passwords).
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=<redacted>
# Comma-separated sender addresses allowed to trigger tasks. Empty = anyone (not recommended).
# GMAIL_ALLOWED_SENDERS=boss@company.com

# --- Quiet hours (Phase F) ---
# HH:MM local time. Schedules don't fire inside the window (run-now still works).
# QUIET_HOURS_START=22:00
# QUIET_HOURS_END=07:00

# --- Calendar (Phase G) ---
# CalDAV endpoint + credentials. Google Calendar:
# https://apidata.googleusercontent.com/caldav/v2/YOU@gmail.com/events
# with an App Password (same as Gmail). Also works with Nextcloud/Fastmail/iCloud.
# CALDAV_URL=
# CALDAV_USERNAME=you@gmail.com
# CALDAV_PASSWORD=<redacted>

# --- MCP servers (Phase C) ---
# JSON list of {name, command, args, env}. Tools appear as mcp_<name>_<tool>.
# MCP_SERVERS=[{"name":"weather","command":"python3","args":["/path/to/weather_server.py"]}]
